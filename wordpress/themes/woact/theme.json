{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1180px"
    },
    "color": {
      "palette": [
        { "slug": "primary", "name": "اصلی", "color": "#0f766e" },
        { "slug": "text", "name": "متن", "color": "#17202a" },
        { "slug": "surface", "name": "سطح", "color": "#ffffff" },
        { "slug": "background", "name": "پس‌زمینه", "color": "#f8fafc" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw", "vh"]
    },
    "typography": {
      "fluid": true
    }
  },
  "styles": {
    "spacing": {
      "blockGap": "1.5rem"
    },
    "typography": {
      "lineHeight": "1.8"
    }
  }
}

